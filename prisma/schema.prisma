generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int      @id @default(autoincrement())
  productName     String
  productCode     String
  productDiscount Float?
  description     String?
  isFeatured      String?
  status          Int      @default(1)
  attributes      Json    
  rating          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Blog {
  id          Int      @id @default(autoincrement())
  blogTitle   String
  description String   
  writerName  String
  status      Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}